# Path to the ArchieSDK checkout (cloned + built via ./build.sh)
# See: https://gitlab.com/_targz/archiesdk
ARCHIESDK = /home/xahmol/riscos-dev/archiesdk

# WSL-visible path to the Arculator install's hostfs folder
# (Arculator itself runs natively on Windows; this is the /mnt/... view of it)
ARCULATOR_HOSTFS = /mnt/d/Retro/Acorn/Arculator_V2.2_Windows/hostfs

# PiEconetBridge (real hardware target) -- SFTP connection details for
# `make deploy-pibridge`, password auth via sshpass (matching how
# FileZilla already connects to this Pi -- install sshpass first:
# sudo apt install sshpass).
PIBRIDGE_USER = xahmol
PIBRIDGE_HOST = 192.168.1.82
PIBRIDGE_PASS = <your Pi login password>
PIBRIDGE_PATH = /home/xahmol/econetfs/0PIBRIDGE-00/Dev
